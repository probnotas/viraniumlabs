# Copy to .env for local development. NEVER commit .env.
# In production, set these as Vercel *sensitive* environment variables:
# Project -> Settings -> Environment Variables -> mark as Sensitive.

# Prefer a restricted key (rk_test_... / rk_live_...) with only the permissions
# listed in STRIPE_INTEGRATION.md over a full secret key.
STRIPE_SECRET_KEY=rk_test_replace_me

# From Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Used to build Checkout success/cancel URLs
SITE_URL=https://viraniumlabs.vercel.app
